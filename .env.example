# Bu dosyayı ".env" adıyla kopyalayıp doldurun. ".env" Git'e gönderilmez.
# GitHub Actions'ta aynı adlarla "Secrets" olarak tanımlayın.

# --- Telegram ---
# BotFather'dan alınan bot anahtarı
TELEGRAM_BOT_TOKEN=
# Bildirimlerin gideceği grup ya da kişi kimliği (grup kimlikleri - ile başlar)
TELEGRAM_CHAT_ID=
# Kaynak hataları için ayrı grup (boş bırakılırsa ana gruba gider)
TELEGRAM_TECH_CHAT_ID=

# --- WhatsApp (isteğe bağlı) ---
# Meta WhatsApp Cloud API test numarası: ücretsiz, en fazla 5 doğrulanmış alıcı. Kurulum README'de.
# Telegram'a giden ana bildirimlerin bir kopyası WhatsApp'a da gider.
# Kalıcı "system user" erişim anahtarı (geçici anahtar 24 saatte biter)
WHATSAPP_TOKEN=
# API Setup sayfasındaki "Phone number ID" (telefon numarasının kendisi değil)
WHATSAPP_PHONE_NUMBER_ID=
# Alıcılar, ülke koduyla, virgülle: 905xxxxxxxxx,905yyyyyyyyy
WHATSAPP_TO=
# Onaylı şablonun adı ve dili (gövdesinde tek değişken {{1}}). İlk deneme için hello_world yazılabilir.
WHATSAPP_TEMPLATE=radar_bildirim
WHATSAPP_TEMPLATE_LANG=tr

# --- E-posta ---
# Şirket e-posta sunucusu ya da Gmail (smtp.gmail.com, uygulama şifresiyle)
SMTP_HOST=
SMTP_PORT=587
# 465 portu kullanılıyorsa true yapın
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Virgülle ayrılmış alıcılar
EMAIL_TO=

# --- Panel ---
# Panelin yayın adresi; bildirimlerdeki "Panelde aç" bağlantısı için (boş bırakılabilir)
PANEL_URL=
