{{ define "otoyol.ay" -}}
{{- $a := . | date "1" -}}
{{- if eq $a "1" }}Ocak{{ else if eq $a "2" }}Şubat{{ else if eq $a "3" }}Mart{{ else if eq $a "4" }}Nisan{{ else if eq $a "5" }}Mayıs{{ else if eq $a "6" }}Haziran{{ else if eq $a "7" }}Temmuz{{ else if eq $a "8" }}Ağustos{{ else if eq $a "9" }}Eylül{{ else if eq $a "10" }}Ekim{{ else if eq $a "11" }}Kasım{{ else }}Aralık{{ end -}}
{{- end -}}

{{- define "otoyol.zaman" -}}
{{- $t := . | tz "Europe/Istanbul" -}}
{{ $t | date "2" }} {{ template "otoyol.ay" $t }} {{ $t | date "2006 15:04" }}
{{- end -}}

{{- define "otoyol.ozet" -}}
{{- if .Annotations.ozet }}{{ .Annotations.ozet }}{{ else }}{{ .Labels.alertname }}{{ end -}}
{{- end -}}

{{- define "otoyol.panel" -}}
{{ reReplaceAll "/+$" "" .ExternalURL }}/d/otoyol-izleme-paneli
{{- end -}}

{{- define "otoyol.konu" -}}
[Otoyol İzleme] {{ if eq .Status "firing" }}🔴 {{ else }}✅ Çözüldü: {{ end -}}
{{- if gt (len .Alerts) 1 }}{{ len .Alerts }} alarm · {{ end -}}
{{- template "otoyol.ozet" (index .Alerts 0) -}}
{{- end -}}

{{- define "otoyol.telegram" -}}
{{- range .Alerts -}}
{{- if eq .Status "firing" }}🔴 <b>ALARM</b>{{ else }}✅ <b>ÇÖZÜLDÜ</b>{{ end }} · {{ .Labels.alertname }}
<b>{{ template "otoyol.ozet" . }}</b>
{{ if eq .Status "firing" -}}
🕒 Başlangıç: {{ template "otoyol.zaman" .StartsAt }}{{ if .Labels.onem }} · Önem: {{ .Labels.onem }}{{ end }}
{{ if .Annotations.aciklama }}
{{ .Annotations.aciklama }}
{{ end -}}
{{- if .Annotations.ne_yapmali }}
<b>Ne yapmalı?</b>
{{ .Annotations.ne_yapmali }}
{{ end -}}
{{- else -}}
🕒 {{ template "otoyol.zaman" .StartsAt }} → {{ template "otoyol.zaman" .EndsAt }}
Sorun giderildi; işlem gerekmez.
{{ end }}
{{ end -}}
<a href="{{ template "otoyol.panel" . }}">İzleme Paneli</a> · <a href="https://github.com/metinakdas/otoyol-ucretleri/actions">GitHub Actions</a> · <a href="https://dash.cloudflare.com/?to=/:account/workers-and-pages">Cloudflare</a>
{{- end -}}

{{- define "otoyol.eposta_duz" -}}
{{- range .Alerts -}}
{{ if eq .Status "firing" }}ALARM{{ else }}ÇÖZÜLDÜ{{ end }}: {{ .Labels.alertname }}

{{ template "otoyol.ozet" . }}

Başlangıç : {{ template "otoyol.zaman" .StartsAt }}
{{ if eq .Status "resolved" }}Bitiş     : {{ template "otoyol.zaman" .EndsAt }}
{{ end }}{{ if .Labels.onem }}Önem      : {{ .Labels.onem }}
{{ end }}
{{ if eq .Status "firing" -}}
{{ if .Annotations.aciklama }}Olası sebepler:
{{ .Annotations.aciklama }}

{{ end }}{{ if .Annotations.ne_yapmali }}Ne yapmalı?
{{ .Annotations.ne_yapmali }}

{{ end }}
{{- else -}}
Sorun giderildi; işlem gerekmez.

{{ end -}}
----------------------------------------
{{ end -}}
İzleme Paneli : {{ template "otoyol.panel" . }}
GitHub Actions: https://github.com/metinakdas/otoyol-ucretleri/actions
Cloudflare    : https://dash.cloudflare.com/?to=/:account/workers-and-pages

Bu e-posta Otoyol Ücretleri izleme sistemi tarafından otomatik oluşturulmuştur.
{{- end -}}

